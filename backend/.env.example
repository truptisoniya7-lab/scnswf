# Server Configuration
PORT=8000
NODE_ENV=development

# CORS Configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Authentication & JWT
JWT_SECRET=scnswf-jwt-secret-key-development-2026-secure
JWT_REFRESH_SECRET=scnswf-jwt-refresh-secret-key-development-2026-secure
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Default Initial Admin Credentials
DEFAULT_ADMIN_EMAIL=admin@scnswf.org
DEFAULT_ADMIN_PASSWORD=AdminSecure@2026

# Database Storage Adapter ('local' file/memory store or 'firebase')
DATA_STORE=firebase

# Firebase Firestore Configuration
# Project Console: https://console.firebase.google.com/u/3/project/project-ngo-scnswf/firestore/databases/-default-/data
FIREBASE_PROJECT_ID=project-ngo-scnswf

# Authentication Option 1: Path to downloaded Service Account JSON file
# Download from: Firebase Console > Project Settings > Service accounts > "Generate new private key"
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Authentication Option 2: Inline Service Account credentials
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=
